# Meowtrack Environment Variables Example
# Copy this file to .env and fill in your actual keys.
# DO NOT commit the actual .env file to version control.

# Google Gemini AI API Key (Get it from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google Maps API Key (Get it from https://console.cloud.google.com/)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
